    <position class="inspire_hand" name="left/index_intermediate"   joint="left/index_intermediate_joint"   ctrlrange="-0.04545 1.56"/>
    <position class="inspire_hand" name="left/middle_proximal"      joint="left/middle_proximal_joint"      ctrlrange="0 1.47"/>
    <position class="inspire_hand" name="left/middle_intermediate"  joint="left/middle_intermediate_joint"  ctrlrange="-0.04545 1.56"/>
    <position class="inspire_hand" name="left/ring_proximal"        joint="left/ring_proximal_joint"        ctrlrange="0 1.47"/>
    <position class="inspire_hand" name="left/ring_intermediate"    joint="left/ring_intermediate_joint"    ctrlrange="-0.04545 1.56"/>
