    <!-- RIGHT RM65 arm (6 DOF) -->
    <position class="rm65_actuator" name="right/joint_1" joint="right/joint_1" ctrlrange="-3.106 3.106"/>
    <position class="rm65_actuator" name="right/joint_2" joint="right/joint_2" ctrlrange="-2.2689 2.2689"/>
    <position class="rm65_actuator" name="right/joint_3" joint="right/joint_3" ctrlrange="-2.356 2.356"/>
    <position class="rm65_actuator" name="right/joint_4" joint="right/joint_4" ctrlrange="-3.106 3.106"/>
    <position class="rm65_actuator" name="right/joint_5" joint="right/joint_5" ctrlrange="-2.234 2.234"/>
    <position class="rm65_actuator" name="right/joint_6" joint="right/joint_6" ctrlrange="-6.28 6.28"/>
    <!-- RIGHT Inspire hand (12 DOF) -->
    <position class="inspire_hand" name="right/thumb_proximal_yaw"   joint="right/thumb_proximal_yaw_joint"   ctrlrange="0 1.308"/>
    <position class="inspire_hand" name="right/thumb_proximal_pitch" joint="right/thumb_proximal_pitch_joint" ctrlrange="0 0.6"/>
    <position class="inspire_hand" name="right/thumb_intermediate"   joint="right/thumb_intermediate_joint"   ctrlrange="0 0.8"/>
    <position class="inspire_hand" name="right/thumb_distal"         joint="right/thumb_distal_joint"         ctrlrange="0 0.4"/>
